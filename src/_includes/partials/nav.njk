<nav class="site-nav" aria-label="Primary navigation">
  <div class="nav-inner">
    <a class="nav-name" href="/">{{ site.author }}</a>
    <div class="nav-links">
      {% for item in nav %}
        <a href="{{ item.url }}" data-nav-link{% if item.section %} data-section="{{ item.section }}"{% endif %}{% if item.match %} data-match="{{ item.match }}"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false">
        <span data-theme-label>Theme</span>
      </button>
    </div>
  </div>
</nav>
