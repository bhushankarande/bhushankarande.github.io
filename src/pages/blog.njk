---
layout: layouts/base.njk
title: Blog
description: Notes on RAG systems, Agentic AI patterns, LLM evaluation, and local model workflows.
permalink: /blog/
bodyClass: blog-index
---
<section class="blog-listing" aria-labelledby="blog-heading">
  <header class="listing-header">
    <h1 id="blog-heading">{{ site.blogTitle }}</h1>
    <p class="blog-subtitle">{{ site.blogSubtitle }}</p>
  </header>

  {% if collections.blogTags.length %}
    <nav class="tag-filter" aria-label="Filter blog posts by tag">
      <a class="tag-pill tag-pill--active" href="/blog/" aria-current="page">All</a>
      {% for tagPage in collections.blogTags %}
        {% set label = tagPage.name %}
        {% set href = "/blog/tag/" + tagPage.slug + "/" %}
        {% set isYear = false %}
        {% include "partials/tag-pill.njk" %}
      {% endfor %}
    </nav>
  {% endif %}

  <ul class="post-list">
    {% for post in collections.posts %}
      {% include "partials/post-card.njk" %}
    {% endfor %}
  </ul>
</section>
