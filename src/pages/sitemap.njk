---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/projects/</loc>
  </url>
  {% for post in collections.posts %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{{ post.date | htmlDateString }}</lastmod>
    </url>
  {% endfor %}
  {% for tagPage in collections.blogTags %}
    <url>
      <loc>{{ site.url }}/blog/tag/{{ tagPage.slug }}/</loc>
    </url>
  {% endfor %}
  {% for yearPage in collections.blogYears %}
    <url>
      <loc>{{ site.url }}/blog/{{ yearPage.year }}/</loc>
    </url>
  {% endfor %}
  {% for project in collections.projects %}
    <url>
      <loc>{{ site.url }}{{ project.url }}</loc>
      <lastmod>{{ project.date | htmlDateString }}</lastmod>
    </url>
  {% endfor %}
</urlset>
