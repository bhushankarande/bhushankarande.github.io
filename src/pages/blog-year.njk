---
layout: layouts/base.njk
pagination:
  data: collections.blogYears
  size: 1
  alias: yearPage
permalink: "/blog/{{ yearPage.year }}/"
bodyClass: blog-index
eleventyComputed:
  title: "Posts from {{ yearPage.year }}"
  description: "Blog posts published in {{ yearPage.year }}."
---
<section class="blog-listing" aria-labelledby="blog-year-heading">
  <header class="listing-header">
    <p class="article-kicker">Year archive</p>
    <h1 id="blog-year-heading">Posts from {{ yearPage.year }}</h1>
    <p class="blog-subtitle">{{ yearPage.posts.length }} post{% if yearPage.posts.length != 1 %}s{% endif %} published in {{ yearPage.year }}.</p>
  </header>

  <nav class="tag-filter" aria-label="Filter blog posts by year">
    <a class="tag-pill" href="/blog/">All</a>
    {% for item in collections.blogYears %}
      {% set label = item.year %}
      {% set href = "/blog/" + item.year + "/" %}
      {% set isYear = true %}
      {% set isActive = item.year == yearPage.year %}
      {% include "partials/tag-pill.njk" %}
    {% endfor %}
  </nav>

  <ul class="post-list">
    {% for post in yearPage.posts %}
      {% include "partials/post-card.njk" %}
    {% endfor %}
  </ul>
</section>
